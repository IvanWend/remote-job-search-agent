# Python
__pycache__/
*.py[cod]
.venv/

# Secrets — .env.example is committed, .env never is
.env

# Local-only notes and editor config — deliberately not shared. docs/ROADMAP.md
# stays tracked; a bare `docs/` here would exclude it, and gitignore cannot
# re-include a file whose parent directory is excluded.
docs/DECISIONS.md
docs/GOTCHAS.md
docs/PROMPT.md
docs/PLAN.md
docs/DB_*.md
AGENTS.md
opencode.json

# Ingested data / gold-set working copies
evals/candidates_*.json
# Working copies carry raw_text; only evals/gold_labeled.json is committed.
evals/gold_*_candidates.json
experiments/*

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Build artifacts (once the package is installable)
dist/
build/
*.egg-info/

# IDE / OS
.vscode/
.idea/
Thumbs.db
