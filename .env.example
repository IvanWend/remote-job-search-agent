# Copy to .env and fill in. .env is git-ignored — never commit it.

# Postgres. Read by docker-compose.yml as ${POSTGRES_PASSWORD:-devpassword};
# if unset, the container silently falls back to that default.
POSTGRES_PASSWORD=change-me

# LLM — needed from Phase 2 (extraction) onward, and Phase 4 (agent).
DEEPSEEK_API_KEY=

# Web3.career ingestion. Free but email-gated. Without a valid token the API
# redirects to the sales page instead of returning an error.
WEB3_API_KEY=

# Postgres connection string used by the ingestion loader.
# Must match POSTGRES_PASSWORD above — psycopg takes this string directly.
DATABASE_URL=postgresql://jobmarket:change-me@localhost:5432/jobmarket

# Frozen eval snapshot (Phase 1b), restored into a second database in the same
# container. Deliberately a different role: jobmarket_ro holds SELECT only, so
# the snapshot cannot drift no matter what connects to it.
EVAL_DATABASE_URL=postgresql://jobmarket_ro:change-me-too@localhost:5432/jobmarket_eval
# Langfuse tracing (Phase 2). Absent keys are not an error — configure_tracing()
# returns None and the pipeline runs untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
